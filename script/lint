#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${HERE}/env" "$@"

cd "${DIR}"
exec bundle exec ruby \
  -I"${DIR}/lib" \
  -rhomebrew_tap \
  -rhomebrew_tap/runner \
  -rhomebrew_tap/test_checks \
  -rhomebrew_tap/commands \
  -e 'exit HomebrewTap::LintCommand.new(argv: ARGV).run' \
  -- "$@"
